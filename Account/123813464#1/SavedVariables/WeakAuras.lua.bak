["unit"] = "player",
["custom"] = "function(allstates, _, _, _, spellID)\n    if spellID and aura_env.spellList[spellID] then\n        local sameAbility = allstates[\"\"] and allstates[\"\"].spellID == spellID\n        \n        local spellInfo = C_Spell.GetSpellInfo(spellID)\n        if spellInfo then\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                spellID = spellID,\n                icon = spellInfo.iconID,\n                same = sameAbility,\n                autoHide = false\n            }\n        end\n        \n        return true\n    end\nend",

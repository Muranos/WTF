["useExactSpellId"] = false,
["match_countOperator"] = ">",
["spellIds"] = {
},
["event"] = "Cast",
["type"] = "custom",
["unit"] = "player",
["use_spellId"] = false,
["custom"] = "function(allstates, event, ...)\n    if event == \"UNIT_SPELLCAST_START\" then\n        local unit, _, spellID = ...\n        if spellID == 395035\n        and WeakAuras.CheckRange(unit, 20, \"<=\")\n        then\n            local _, _, _, startC, endC  = UnitCastingInfo(unit)\n            local duration = (endC - startC) / 1000\n            local expirationTime = endC / 1000\n            if endC then\n                allstates[UnitGUID(unit)] = {\n                    show = true,\n                    changed = true,\n                    progressType = \"timed\",\n                    duration = duration,\n                    expirationTime = expirationTime,\n                    autoHide = true,\n                } \n                return true\n            end\n        end\n    elseif event == \"UNIT_SPELLCAST_STOP\" then\n        local unit, _, spellID = ...\n        if spellID == 395035 then\n            local state = allstates[UnitGUID(unit)]\n            if state then\n                state.changed = true\n                state.show = false\n                return true\n            end\n        end\n    end\n    \nend",
["events"] = "UNIT_SPELLCAST_START:nameplate, UNIT_SPELLCAST_STOP:nameplate",
["check"] = "event",
["subeventSuffix"] = "_CAST_START",
["auraspellids"] = {
},

["custom"] = "\n\n",
["do_custom"] = false,
},
["init"] = {
["custom"] = "aura_env.db = { }\n\n-- transliteration\naura_env.langDB = {\n    \n    -- Chinese (Simplified)\n    [\"zhCN\"] = \"每周任务\",\n    \n    -- Chinese (Taiwan)\n    [\"zhTW\"] = \"每週任務\",\n    \n    -- English (US)\n    [\"enUS\"] = \"Weekly\",\n    \n    -- French (FR)\n    [\"frFR\"] = \"Hebdomadaire\",\n    \n    -- German\n    [\"deDE\"] = \"Wöchentlich\",\n    \n    -- Korean (KR)\n    [\"koKR\"] = \"주간\",\n    \n    -- Russian (RU)\n    [\"ruRU\"] = \"Еженедельный\",\n}",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "",
["do_message"] = false,
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "status",
["custom_hide"] = "custom",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["unit"] = "player",
["subeventPrefix"] = "SPELL",
["customName"] = "function()\n    return aura_env.langDB[GetLocale()] or aura_env.langDB[\"enUS\"]\nend",
["spellIds"] = {
},
["names"] = {
},
["check"] = "event",
["custom"] = "function(event, ...)\n    -- parse input\n    if event == \"HDH_WEEK\" then\n        local clone, value = ...\n        aura_env.db = { [clone] = value }\n    end\n    \n    -- check if anything is showing\n    local count = 0\n    for _, i in pairs(aura_env.db) do\n        count = i == 1 and count + 1\n    end    \n    if count == 0 then return end\n    \n    if aura_env.config.weekly.weeklyEnable then return true end\nend",
["events"] = "START, QUEST_COMPLETE, HDH_WEEK",
["debuffType"] = "HELPFUL",
},

["source"] = "import",
["actions"] = {
["start"] = {
["custom"] = "local region = WeakAuras.GetRegion(aura_env.id, aura_env.cloneId)\nif region and region.state and region.state.show then\n    local color = region.state.color\n    region:Color(color[1]/255,color[2]/255,color[3]/255,.8)\n    WeakAuras.ScanEvents(\"HDH_ACTIVITY\", region.state.event, 1)\nend",
["do_custom"] = true,
},
["init"] = {
["custom"] = "aura_env.db = {\n    ----------------------------------------------------------------\n    -- Aylaag Camp\n    ----------------------------------------------------------------\n    [\"aylaagCamp\"] = {\n        [\"name\"] = {\n            --[\"deDE\"] = \"\",\n            [\"enUS\"] = \"Aylaag Camp\",\n            [\"frFR\"] = \"Camp Aylaag\",\n            --[\"koKR\"] = \"\",\n            --[\"ruRU\"] = \"\",\n            [\"zhCN\"] = \"艾拉格营地\",\n            [\"zhTW\"] = \"艾拉格營地\",\n        },\n        [\"alert\"] = 0,\n        [\"questReq\"] = 1,\n        [\"questID\"] = { 0 },\n        [\"color\"] = { 107, 134, 66 },\n        [\"interval\"] = 270000,\n        [\"duration\"] = 900,\n        [\"epoch\"] = { [1] = 1675566000, [2] = 1675612800, [3] = 1675612800, [4] = 1677571200 }\n    },\n    \n    ----------------------------------------------------------------\n    -- The Big Dig\n    ----------------------------------------------------------------\n    [\"bigDig\"] = {\n        [\"name\"] = {\n            [\"deDE\"] = \"großen Buddeln\",\n            [\"enUS\"] = \"The Big Dig\",\n            [\"frFR\"] = \"la grande fouille\",\n            [\"koKR\"] = \"대규모 발굴\",\n            [\"ruRU\"] = \"больших раскопках\",\n            [\"zhCN\"] = \"盛大发掘\",\n            [\"zhTW\"] = \"重大挖掘\",\n        },\n        [\"alert\"] = 3,\n        [\"questReq\"] = 1,\n        [\"questID\"] = { 79226 },\n        [\"color\"] = { 184, 206, 98 },\n        [\"interval\"] = 3600,\n        [\"duration\"] = 600,\n        [\"epoch\"] = { [1] = 1705617034, [2] = 1705617034, [3] = 1705617034, [4] = 1705617034 }\n    },\n    \n    ----------------------------------------------------------------\n    -- Community Feast\n    ----------------------------------------------------------------\n    [\"commFeast\"] = {\n        [\"name\"] = {\n            [\"deDE\"] = \"Festmahl\",\n            [\"enUS\"] = \"Community Feast\",\n            [\"frFR\"] = \"Festin tribal\",\n            [\"koKR\"] = \"공동체 잔치\",\n            [\"ruRU\"] = \"Большое пиршество\",\n            [\"zhCN\"] = \"社区盛宴\",\n            [\"zhTW\"] = \"集體盛宴\",\n        },\n        [\"alert\"] = 1,\n        [\"questReq\"] = 1,\n        [\"questID\"] = { 70893 },\n        [\"color\"] = { 80, 159, 238 },\n        [\"interval\"] = 5400,\n        [\"duration\"] = 900,\n        [\"epoch\"] = { [1] = 1670333460, [2] = 1670702460, [3] = 1670331660, [4] = 1670702460 }\n    },\n    \n    ----------------------------------------------------------------\n    -- Siege on Dragonbane Keep\n    ----------------------------------------------------------------\n    [\"siegeKeep\"] = {\n        [\"name\"] = {\n            [\"deDE\"] = \"Belagerung\",\n            [\"enUS\"] = \"Dragonbane Keep\",\n            [\"frFR\"] = \"Donjon de Dragons\",\n            [\"koKR\"] = \"성채 공성전\",\n            [\"ruRU\"] = \"Штурм Драконьей погибели\",\n            [\"zhCN\"] = \"围攻灭龙要塞\",\n            [\"zhTW\"] = \"龍禍要塞\",\n        },\n        [\"alert\"] = 2,\n        [\"questReq\"] = 1,\n        [\"questID\"] = { 70866 },\n        [\"color\"] = { 229, 89, 99 },\n        [\"interval\"] = 7200,\n        [\"duration\"] = 600,\n        [\"epoch\"] = { [1] = 1670338860, [2] = 1670698860, [3] = 1670342460, [4] = 1670698860 }\n    },\n    \n    ----------------------------------------------------------------\n    -- Dream Surge\n    ----------------------------------------------------------------\n    [\"dreamSurge\"] = {\n        [\"name\"] = {\n            --[\"deDE\"] = \"\",\n            [\"enUS\"] = \"Dream Surge\",\n            [\"frFR\"] = \"Poussée onirique\",\n            --[\"koKR\"] = \"\",\n            --[\"ruRU\"] = \"\",\n            [\"zhCN\"] = \"梦涌\",\n            [\"zhTW\"] = \"夢境湧現\",\n        },\n        [\"alert\"] = 3,\n        [\"questReq\"] = 1,\n        [\"questID\"] = { 77251 },\n        [\"color\"] = { 46, 189, 125 },\n        [\"interval\"] = 1800,\n        [\"duration\"] = 300,\n        [\"epoch\"] = { [1] = 1694329215, [2] = 169453815, [3] = 1700339400, [4] = 169453815 }\n    },\n    \n    ----------------------------------------------------------------\n    -- The Grand Hunt\n    ----------------------------------------------------------------\n    [\"grandHunt\"] = {\n        [\"name\"] = {\n            [\"deDE\"] = \"Die Große Jagd\",\n            [\"enUS\"] = \"Grand Hunt\",\n            [\"frFR\"] = \"Grandes chasses\",\n            [\"koKR\"] = \"사냥의 제전\",\n            [\"ruRU\"] = \"Великая охота\",\n            [\"zhCN\"] = \"洪荒狩猎\",\n            [\"zhTW\"] = \"大狩獵\",\n        },\n        [\"alert\"] = 0,\n        [\"questReq\"] = 1,\n        [\"questID\"] = { 70906 },\n        [\"color\"] = { 239, 185, 62 },\n        [\"interval\"] = 7200,\n        [\"duration\"] = 7199,\n        [\"epoch\"] = { [1] = 1671303600, [2] = 1670338800, [3] = 1671307200, [4] = 1670338800 }\n    },\n    \n    ----------------------------------------------------------------\n    -- Primal Storms\n    ----------------------------------------------------------------\n    [\"primalStorm\"] = {\n        [\"name\"] = {\n            [\"deDE\"] = \"Elementarsturm\",\n            [\"enUS\"] = \"Primal Storms\",\n            [\"frFR\"] = \"Tempêtes élémentaires\",\n            [\"koKR\"] = \"정령 폭풍\",\n            [\"ruRU\"] = \"Изначальные бури\",\n            [\"zhCN\"] = \"元素风暴\",\n            [\"zhTW\"] = \"元素風暴\",\n        },\n        [\"alert\"] = 3,\n        [\"questReq\"] = 4,\n        [\"questID\"] = { 70753, 70723, 70754, 70752 },\n        [\"color\"] = { 193, 150, 150 },\n        [\"interval\"] = 10800,\n        [\"duration\"] = 7200,\n        [\"epoch\"] = { [1] = 1671310800, [2] = 1670346000, [3] = 1671303600, [4] = 1670346000 }\n    },\n    \n    ----------------------------------------------------------------\n    -- Researchers Under Fire\n    ----------------------------------------------------------------\n    [\"underFire\"] = {\n        [\"name\"] = {\n            --[\"deDE\"] = \"\",\n            [\"enUS\"] = \"Researchers Under Fire\",\n            [\"frFR\"] = \"Des chercheurs sous le feu\",\n            [\"koKR\"] = \"불타고 있는 연구원들\",\n            [\"ruRU\"] = \"Исследователи под огнём\",\n            [\"zhCN\"] = \"研究员遇袭\",\n            [\"zhTW\"] = \"遭攻擊的研究員\",\n        },\n        [\"alert\"] = 0,\n        [\"questReq\"] = 1,\n        [\"questID\"] = { 75629, 75630, 75628, 75627 },\n        [\"color\"] = { 206, 226, 81 },\n        [\"interval\"] = 3600,\n        [\"duration\"] = 1500,\n        [\"epoch\"] = { [1] = 1670333460, [2] = 1670703360, [3] = 1683804640, [4] = 1670702460 }\n    },\n    \n    ----------------------------------------------------------------\n    -- The Storm's Fury\n    ----------------------------------------------------------------\n    [\"stormsFury\"] = {\n        [\"name\"] = {\n            [\"deDE\"] = \"Der Zorn des Sturms\",\n            [\"enUS\"] = \"Storm's Fury\",\n            [\"frFR\"] = \"Fureur de l'orage\",\n            [\"koKR\"] = \"폭풍의 격노\",\n            [\"ruRU\"] = \"Ярость шторма\",\n            [\"zhCN\"] = \"暴风之怒\",\n            [\"zhTW\"] = \"風暴之怒\",\n        },\n        [\"alert\"] = 0,\n        [\"questReq\"] = 1,\n        [\"questID\"] = { 74378 },\n        [\"color\"] = { 171, 73, 253 },\n        [\"interval\"] = 18000,\n        [\"duration\"] = 7200,\n        [\"epoch\"] = { [1] = 1676120400, [2] = 1676145600, [3] = 1676131200, [4] = 1675922400 }\n    },\n    \n    ----------------------------------------------------------------\n    -- The Superbloom\n    ----------------------------------------------------------------\n    [\"superbloom\"] = {\n        [\"name\"] = {\n            --[\"deDE\"] = \"\",\n            [\"enUS\"] = \"Superbloom\",\n            [\"frFR\"] = \"Superfloraison\",\n            [\"koKR\"] = \"만개화\",\n            --[\"ruRU\"] = \"\",\n            [\"zhCN\"] = \"超然盛放\",\n            [\"zhTW\"] = \"繁盛綻放\",\n        },\n        [\"alert\"] = 0,\n        [\"questReq\"] = 1,\n        [\"questID\"] = { 78319 },\n        [\"color\"] = { 120, 255, 194 },\n        [\"interval\"] = 3600,\n        [\"duration\"] = 1200,\n        [\"epoch\"] = { [1] = 1699412400, [2] = 1699434010, [3] = 1699412400, [4] = 1699434010 }\n    },\n    \n    ----------------------------------------------------------------\n    -- Time Rifts\n    ----------------------------------------------------------------\n    [\"timeRift\"] = {\n        [\"name\"] = {\n            --[\"deDE\"] = \"\",\n            [\"enUS\"] = \"Time Rift\",\n            [\"frFR\"] = \"Faille temporelle\",\n            --[\"koKR\"] = \"\",\n            --[\"ruRU\"] = \"\",\n            [\"zhCN\"] = \"时光裂隙\",\n            [\"zhTW\"] = \"時間裂隙\",\n        },\n        [\"alert\"] = 4,\n        [\"questReq\"] = 1,\n        [\"questID\"] = { 77836 },\n        [\"color\"] = { 255, 135, 31 },\n        [\"interval\"] = 3600,\n        [\"duration\"] = 900,\n        [\"epoch\"] = { [1] = 1701831600, [2] = 1701853200, [3] = 1689274800, [4] = 1701849600 }\n    },\n    \n    ----------------------------------------------------------------\n    -- Vault Primal Storm\n    ----------------------------------------------------------------\n    [\"vaultStorm\"] = {\n        [\"name\"] = {\n            --[\"deDE\"] = \"\",\n            [\"enUS\"] = \"Vault Primal Storm\",\n            --[\"frFR\"] = \"\",\n            [\"koKR\"] = \"금지된 해안 금고\",\n            --[\"ruRU\"] = \"\",\n            [\"zhCN\"] = \"霜石风暴\",\n            [\"zhTW\"] = \"密庫洪荒風暴\",\n        },\n        [\"alert\"] = 0,\n        [\"questReq\"] = 1,\n        [\"questID\"] = { 0 },\n        [\"color\"] = { 167, 238, 85 },\n        [\"interval\"] = 7200,\n        [\"duration\"] = 600,\n        [\"epoch\"] = { [1] = 1680138000, [2] = 1680224240, [3] = 1680141600, [4] = 1680222660 }\n    },\n}\n\n\n\n\n\n\n\n",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "local auraID, cloneID  = aura_env.id, aura_env.cloneId\nC_Timer.After(0, function() WeakAuras.ScanEvents(\"DRAGONFLIGHT_EVENT_TRACKER\", auraID) end)\n\nlocal region = WeakAuras.GetRegion(auraID, cloneID)\nif region then\n    WeakAuras.ScanEvents(\"HDH_ACTIVITY\", region.state.event, 0)\nend",
["do_custom"] = true,
},

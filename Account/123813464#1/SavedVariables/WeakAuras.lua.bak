},
["realSpellName"] = 0,
["use_spellName"] = true,
["custom"] = "function(allstates, event, ...)\n    if event == \"UNIT_SPELLCAST_CHANNEL_START\" then \n        local unit, _, spellID = ...\n        if spellID == 386559 then\n            allstates[\"surge\"] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = 2.5,\n                expirationTime = 2.5 + GetTime(),\n                autoHide = true,\n                remaining = 4,\n            }\n            for i = 1,3 do\n                C_Timer.After(2.5*i, function() WeakAuras.ScanEvents(\"CAUSESE_SURGE_REPEAT\", 4-i) end)\n            end\n            return true\n        end\n    elseif event == \"CAUSESE_SURGE_REPEAT\" and ... then\n        local i, guid = ...\n        allstates[\"surge\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 2.5,\n            expirationTime = 2.5 + GetTime(),\n            remaining = i,\n            autoHide = true,\n        }\n        return true\n    end\nend",

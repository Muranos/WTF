["type"] = "custom",
["scalex"] = 1,
["easeType"] = "none",
["x"] = 0,
["scaley"] = 1,
["alpha"] = 0,
["easeStrength"] = 3,
["y"] = 0,
["colorType"] = "custom",
["preset"] = "fade",
["colorA"] = 1,
["colorFunc"] = "function()\n    if not aura_env.config.TrackHealth then\n        return 255,255,255,0\n    end\n    \nend\n\n\n",

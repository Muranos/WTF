["init"] = {
["custom"] = "-- Default Locale --\naura_env.defaultLocale = 'enUS'\n-- User Locale Var--\naura_env.userLocale = GetLocale()\n-- Get Text sinppet --\naura_env.get_text_snippet = function(name)\n    if aura_env.textSnippets[name] and aura_env.textSnippets[name][aura_env.userLocale] then\n        return aura_env.textSnippets[name][aura_env.userLocale]\n    end\n    if aura_env.textSnippets[name] and aura_env.textSnippets[name][aura_env.defaultLocale] then\n        return aura_env.textSnippets[name][aura_env.defaultLocale]\n    end\n    return name\nend\n\nfunction aura_env.isComplete()\n    if C_QuestLog.IsQuestFlaggedCompleted(74378) then\n        return true\n    end\n    \n    return false\nend",
["do_custom"] = true,

["init"] = {
["custom"] = "--[[\nReport bugs on discord to anDe#0001 on discord or on wago. If you want to edit and reupload feel free, but give credit to Causese who wrote the base code that this WA was based on \n(I totally didn't ask him when i stole the code)\n]]\n--[[Not finding a mob you want marked? enter NPCID below if you want to include it to be marked, you can find NPCID on wowhead url of said mob, example url:\nhttps://www.wowhead.com/npc=128551/irontide-mastiff\nsimply add a row like this:\n[\"128551\"] = true,\nwhere 128551 is the NPC id\ndon't bother with config stuff. that's just for custom config tab\n1=star, 2=circle, 3=diamond, 4=triangle, 5=moon, 6=square, 7=cross, 8=skull\n\n]]\naura_env.orderList = {\n    [\"defaultOrder\"] = {1,3,6,4,5},\n    [\"caster1\"] = {6,3,4,1,5,2,7,8},\n    [\"caster2\"] = {6,7,1},\n    [\"nonCaster1\"] = {3,4,6,7,2,8,5,1},\n    [\"nonCaster2\"] = {6,8,5,7,4,3,2,1},\n    [\"prio\"] = {8,7,5,4,3,2},\n    \n}\n\naura_env.getOrder = function(NPCid) \n    local orderName = aura_env.mobList[NPCid] or \"defaultOrder\"\n    return  aura_env.orderList[orderName] or aura_env.orderList[\"defaultOrder\"]\nend\n\naura_env.setTankMark = function()\n    if aura_env.config.settingsGroup.markTank == 1 then return end\n    for unit in WA_IterateGroupMembers() do\n        if UnitGroupRolesAssigned(unit) == \"TANK\" and not GetRaidTargetIndex(\"mouseover\") then \n            SetRaidTarget(unit, aura_env.config.settingsGroup.markTank - 1)\n        end\n        return\n    end\nend\n\n\naura_env.mobList = {\n    --Ruby Life Pools\n    [\"187969\"] = aura_env.config.npc187969 and \"nonCaster1\", --Flashfrost Earthshaper\n    [\"188067\"] = aura_env.config.npc188067, --Flashfrost Chillweaver    \n    [\"187894\"] = aura_env.config.npc187894, --Infused Whelp\n    [\"190207\"] = aura_env.config.npc190207, --Primalist Cinderweaver    \n    [\"190206\"] = aura_env.config.npc190206 and \"nonCaster1\", --Primalist Flamedancer\n    [\"195119\"] = aura_env.config.npc195119, --Primalist Shockcaster\n    [\"198047\"] = aura_env.config.npc198047, --Tempest Channeler   \n    [\"197985\"] = aura_env.config.npc197985, --Flame Channeler\n    [\"197535\"] = aura_env.config.npc197535, --High Channeler Ryvati\n    \n    \n    --The Azure Vaults\n    [\"196102\"] = aura_env.config.npc196102, --Conjured Lasher    \n    [\"191164\"] = aura_env.config.npc191164, --Arcane Tender?????\n    [\"187159\"] = aura_env.config.npc187159, --Shrieking Whelp\n    [\"187154\"] = aura_env.config.npc187154, --Unstable Curator\n    [\"196116\"] = aura_env.config.npc196116 and \"prio\", --Crystal Fury\n    [\"186741\"] = aura_env.config.npc186741, --Arcane Elemental\n    [\"187155\"] = aura_env.config.npc187155, --Rune Seal Keeper\n    \n    --Algeth’ar Academy\n    [\"196045\"] = aura_env.config.npc196045, --Corrupted Manafiend\n    [\"196576\"] = aura_env.config.npc196576, --Spellbound Scepter\n    [\"196044\"] = aura_env.config.npc196044, --Unruly Textbook\n    [\"192333\"] = aura_env.config.npc192333, --Alpha Eagle\n    [\"196548\"] = aura_env.config.npc196548, --Ancient Branch (tree boss add)\n    [\"196198\"] = aura_env.config.npc196198, --Algeth'ar Security\n    [\"196202\"] = aura_env.config.npc196202, --Algeth'ar Educator\n    [\"196203\"] = aura_env.config.npc196203, --Algeth'ar Nurse\n    \n    --The Nokhud Offensive\n    [\"192796\"] = aura_env.config.npc192796 and \"nonCaster1\", --Nokhud Hornsounder\n    [\"191847\"] = aura_env.config.npc191847, --Nokhud Plainstomper\n    [\"192800\"] = aura_env.config.npc192800, --Nokhud Lancemaster\n    [\"192789\"] = aura_env.config.npc192789 and \"prio\", --Nokhud Longbow*\n    [\"192794\"] = aura_env.config.npc192794 and \"nonCaster1\", --Nokhud Beastmaster*\n    [\"192791\"] = aura_env.config.npc192791 and \"prio\", --Warspear\n    [\"194317\"] = aura_env.config.npcStormcallers, --Stormcaller Boroo\n    [\"194315\"] = aura_env.config.npcStormcallers, --Stormcaller Solongo\n    [\"195265\"] = aura_env.config.npcStormcallers, --Stormcaller Arynga\n    [\"194316\"] = aura_env.config.npcStormcallers, --Stormcaller Zarii\n    [\"194898\"] = aura_env.config.npc194898 and \"nonCaster1\", --Primalist Arcblade\n    [\"194895\"] = aura_env.config.npc194895 and \"prio\", --Unstable Squall\n    [\"194894\"] = aura_env.config.npc194894, --Primalist Stormspeaker\n    [\"194896\"] = aura_env.config.npc194896, --Primal Stormshield\n    [\"195877\"] = aura_env.config.npc195877, --Risen Mystic\n    [\"196263\"] = aura_env.config.npc196263, --Nokhud Neophyte\n    [\"195842\"] = aura_env.config.npc195842, --Ukhel Corruptor\n    [\"195878\"] = aura_env.config.npc195878, --Ukhel Beastcaller\n    [\"195847\"] = aura_env.config.npc195847, --Ukhel Willcrusher\n    [\"195851\"] = aura_env.config.npc195851 and \"prio\", --Ukhel Deathspeaker\n    [\"195929\"] = aura_env.config.npcSoulharvester, --Soulharvester Tumen\n    [\"195930\"] = aura_env.config.npcSoulharvester, --Soulharvester Mandakh\n    [\"195927\"] = aura_env.config.npcSoulharvester, --Soulharvester Galtmaa\n    [\"195928\"] = aura_env.config.npcSoulharvester, --Soulharvester Duuren\n    \n    \n    --Halls of Valor\n    [\"95842\"] = aura_env.config.npc95842, --Valarjar Thundercaller\n    [\"95834\"] = aura_env.config.npc95834, --Valarjar Mystic\n    [\"96664\"] = aura_env.config.npc96664, --Valarjar Runecarver\n    [\"97197\"] = aura_env.config.npc97197, --Valarjar Purifier\n    [\"96611\"] = aura_env.config.npc96611, --Angerhoof Bull\n    [\"96934\"] = aura_env.config.npc96934, --Valarjar Trapper\n    [\"97202\"] = aura_env.config.npc97202, --Olmyr the Enlightened\n    [\"97083\"] = aura_env.config.npcKings, --King Ranulf\n    [\"95843\"] = aura_env.config.npcKings, --King Haldor\n    [\"97081\"] = aura_env.config.npcKings, --King Bjorn\n    [\"97084\"] = aura_env.config.npcKings, --King Tor\n    [\"101326\"] = aura_env.config.npc101326, --Honored Ancestor\n    [\"102019\"] = aura_env.config.npc102019, --Odyn Add\n    \n    --Court of Stars\n    [\"104251\"] = aura_env.config.npc104251 and \"prio\", --Duskwatch Sentry\n    [\"104270\"] = aura_env.config.npc104270, --Guardian Construct\n    [\"104247\"] = aura_env.config.npc104247, --Duskwatch Arcanist\n    [\"105704\"] = aura_env.config.npc105704, --Arcane Manifestation\n    [\"105715\"] = aura_env.config.npc105715, --Watchful Inquisitor\n    [\"104300\"] = aura_env.config.npc104300, --Shadow Mistress\n    \n    --Shadowmoon Burial Grounds\n    [\"75713\"] = aura_env.config.npc75713, --Shadowmoon Bone-Mender\n    [\"75506\"] = aura_env.config.npc75506, --Shadowmoon Loyalist\n    [\"76446\"] = aura_env.config.npc76446, --Shadowmoon Enslaver\n    [\"77700\"] = aura_env.config.npc77700, --Shadowmoon Exhumer\n    [\"75459\"] = aura_env.config.npc75459, --Plagued Bat*\n    [\"76104\"] = aura_env.config.npc76104, --Monstrous Corpse Spider\n    [\"75979\"] = aura_env.config.npc75979, --Exhumed Spirit\n    \n    \n    --Temple of the Jade Serpent\n    [\"200126\"] = aura_env.config.npc200126, --Fallen Waterspeaker\n    [\"59555\"] = aura_env.config.npc59555, --Haunting Sha\n    [\"59546\"] = aura_env.config.npc59546, --The Talking Fish\n    [\"59552\"] = aura_env.config.npc59552, --The Crybaby Hozen\n    [\"200131\"] = aura_env.config.npc200131, --Sha-Touched Guardian\n    [\"200137\"] = aura_env.config.npc200137, --Depraved Mistwaver\n    \n}\n\n\n\n\n--DO NOT TOUCH\naura_env.marks = {}\naura_env.assigned = {}",

ion Quests\n        ------------------------------------------------------------\n        [\"profQuest\"] = {\n            [\"name\"] = aura_env.langDB.quest,       \n            [\"showCount\"] = true,\n            [\"sort\"] = 5,            \n            [\"questDB\"] = {\n                [171] = { [\"questReq\"] = 2, [\"questID\"]  = { 66937, 66938, 66940, 70530, 70531, 70532, 72427, 75363, 75371, 70533, 77932, 77933 } },\n                [164] = { [\"questReq\"] = 2, [\"questID\"]  = { 66517, 66897, 66941, 70211, 70233, 70234, 70235, 72398, 75569, 75148, 77935, 77936 } },\n                [333] = { [\"questReq\"] = 2, [\"questID\"]  = { 66884, 66900, 66935, 72155, 72172, 72173, 72175, 72423, 75865, 75150, 77910, 77937 } },\n                [202] = { [\"questReq\"] = 2, [\"questID\"]  = { 66890, 66891, 66942, 70540, 70539, 70545, 70557, 72396, 75575, 75608, 77891, 77938 } },\n                [182] = { [\"questReq\"] = 1, [\"questID\"]  = { 70613, 70614, 70615, 70616 } },\n                [773] = { [\"questReq\"] = 2, [\"questID\"]  = { 66943, 66944, 66945, 70558, 70559, 70560, 70561, 72438, 75573, 75149, 77889, 77914 } },\n                [755] = { [\"questReq\"] = 2, [\"questID\"]  = { 66516, 66949, 66950, 70562, 70563, 70564, 70565, 72428, 75362, 75602, 77912, 77892 } },\n                [165] = { [\"questReq\"] = 2, [\"questID\"]  = { 66363, 66364, 66951, 70567, 70568, 70569, 70571, 72407, 75354, 75368, 77945, 77946 } },\n                [186] = { [\"questReq\"] = 1, [\"questID\"]  = { 70617, 70618, 72156, 72157 } },\n                [393] = { [\"questReq\"] = 1, [\"questID\"]  = { 70619, 70620, 72158, 72159 } },\n                [197] = { [\"questReq\"] = 2, [\"questID\"]  = { 66899, 66952, 66953, 70572, 70582, 70586, 70587, 72410, 75407, 75600, 77947, 77949 } },\n            }\n        },        \n        ------------------------------------------------------------\n        -- Treatise\n        ------------------------------------------------------------\n        [\"treatise\"] = {\n            [\"name\"] = aura_env.langDB.treatise,\n            [\"showCount\"] = false,\n            [\"sort\"] = 7,            \n            [\"questDB\"] = {\n                [171] = { [\"questReq\"] = 1, [\"questID\"] = { 74108 } },\n                [164] = { [\"questReq\"] = 1, [\"questID\"] = { 74109 } },\n                [333] = { [\"questReq\"] = 1, [\"questID\"] = { 74110 } },\n                [202] = { [\"questReq\"] = 1, [\"questID\"] = { 74111 } },\n                [182] = { [\"questReq\"] = 1, [\"questID\"] = { 74107 } },\n                [773] = { [\"questReq\"] = 1, [\"questID\"] = { 74105 } },\n                [755] = { [\"questReq\"] = 1, [\"questID\"] = { 74112 } },\n                [165] = { [\"questReq\"] = 1, [\"questID\"] = { 74113 } },\n                [186] = { [\"questReq\"] = 1, [\"questID\"] = { 74106 } },\n                [393] = { [\"questReq\"] = 1, [\"questID\"] = { 74114 } },\n                [197] = { [\"questReq\"] = 1, [\"questID\"] = { 74115 } }\n            },\n            [\"extra\"] = {\n                [\"foot\"] = \"|n|nShift + Left Click to track recipe.\",\n                [74108] = { [\"itemID\"] = 194697, [\"recipeID\"] = 383522 },\n                [74109] = { [\"itemID\"] = 198454, [\"recipeID\"] = 383517 },\n                [74110] = { [\"itemID\"] = 194702, [\"recipeID\"] = 383523 },\n                [74111] = { [\"itemID\"] = 198510, [\"recipeID\"] = 383844 },\n                [74107] = { [\"itemID\"] = 194704, [\"recipeID\"] = 383515 },\n                [74105] = { [\"itemID\"] = 194699, [\"recipeID\"] = 383759 },\n                [74112] = { [\"itemID\"] = 194703, [\"recipeID\"] = 383524 },\n                [74113] = { [\"itemID\"] = 194700, [\"recipeID\"] = 383519 },\n                [74106] = { [\"itemID\"] = 194708, [\"recipeID\"] = 383516 },\n                [74114] = { [\"itemID\"] = 201023, [\"recipeID\"] = 392944 },\n                [74115] = { [\"itemID\"] = 194698, [\"recipeID\"] = 383520 }\n            }\n        }\n    }\n}",

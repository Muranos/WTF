["custom"] = "local s = aura_env.state\nif s and s.hide > 0 and s.hide < 60 then\n    local aura_env = aura_env\n    C_Timer.After(s.hide, function()\n            WeakAuras.ScanEvents(\"RELOE_SPELLCD_STATE_CLEAN\", s.GUID..s.spellID, s.expirationTime, aura_env.id)\n    end)\nend\n\n\n\n\n",

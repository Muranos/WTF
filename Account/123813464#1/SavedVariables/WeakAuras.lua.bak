["customText"] = "function(t)\n    if aura_env.state and aura_env.state.spellId then\n        local spellID = aura_env.state.spellId\n        if spellID == 392170 then\n            return \"Melee\"\n        elseif spellID == 384595 then\n            return \"Throw\"\n        elseif spellID == 376762 then\n            return \"Range\"\n        elseif spellID == 392164 then\n            return \"Charge\"\n        elseif spellID == 392258 then\n            return \"Frontal\"\n        end\n    end\nend",

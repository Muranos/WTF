["custom"] = "function(allstates, e, ...)\n    if aura_env.show then\n        if e == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n            local sourceGUID = select(4, ...)\n            if sourceGUID == aura_env.playerGUID then\n                local spellID = select(12, ...)\n                if spellID == 450617 or spellID == 450620 then                \n                    local sub = select(2, ...)                \n                    \n                    if (not allstates[\"\"]) or (not allstates[\"\"].show) then  \n                        aura_env.requestReset({fs = true, event = e, subEvent = sub})                  \n                        local info = C_Spell.GetSpellInfo(spellID)\n                        if info then\n                            allstates[\"\"] = {\n                                show = true,\n                                changed = true,\n                                progress = \"timed\",\n                                duration = aura_env.fsDuration,\n                                expirationTime = GetTime() + aura_env.fsDuration,\n                                autoHide = true,\n                                icon = info.iconID\n                            } \n                            return true\n                        end\n                    end\n                end\n            end\n        end\n    end\nend\n\n\n",

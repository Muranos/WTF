["customText"] = "function()\n    spellID = aura_env.states[2].spellId\n    if spellID == 405807 then\n        output = \"Anger\"\n    elseif spellID == 405808 then\n        output = \"Doubt\"\n    elseif spellID == 405809 then\n        output = \"Fear\"\n    elseif spellID == 405810 then\n        output = \"Despair\"\n    else\n        output = nil\n    end\n    \n    return output\nend\n\n\n",

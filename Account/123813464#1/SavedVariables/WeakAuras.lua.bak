["events"] = "CLEU:SPELL_CAST_START",
["custom"] = "function(allstates, event, ...)\n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local timestamp, subEvent, hideCaster, sourceGUID, sourceName, sourceFlags, sourceRaidFlags, destGUID, destName, destFlags, destRaidFlags, spellID, _,_, auraType = ...\n        if subEvent == \"SPELL_CAST_START\"\n        and spellID == 383693 then\n            local aura = C_UnitAuras.GetPlayerAuraBySpellID(384492)\n            if aura and aura.sourceUnit and UnitGUID(aura.sourceUnit) == sourceGUID then\n                allstates[sourceGUID] = {\n                    show = true,\n                    changed = true,\n                    progressType = \"timed\",\n                    duration = 2,\n                    expirationTime = 2 + GetTime(),\n                    autoHide = true,\n                }\n                return true\n            end\n        end\n    end\nend",

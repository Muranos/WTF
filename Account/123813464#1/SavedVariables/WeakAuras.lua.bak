["customTextUpdate"] = "event",
["url"] = "https://wago.io/1ctv3b91K/18",
["actions"] = {
["start"] = {
["do_custom"] = false,
["do_sound"] = false,
},
["init"] = {
["custom"] = "\n\n",
["do_custom"] = false,
},
["finish"] = {

["Professions Bar (HDH)"] = {
["sparkWidth"] = 10,
["sparkOffsetX"] = 0,
["wagoID"] = "Jp563BG-w",
["xOffset"] = 0,
["preferToUpdate"] = false,
["customText"] = "function()\n    local item = aura_env.item\n    \n    -- completion coloring\n    local color = aura_env.isComplete() and \"|cFFaad372\" or \"|cFFffffff\"\n    \n    -- fish count\n    local count = aura_env.config.weekly.crCount and item.Count .. \"/20\" or \"\"\n    \n    -- output\n    return color .. item.Name, color .. count\nend",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["spark"] = false,
["iconSource"] = -1,
["sparkRotation"] = 0,
["sparkRotationMode"] = "AUTO",
["url"] = "https://wago.io/HalduDFHelper/151",
["actions"] = {
["start"] = {
["custom"] = "local region = WeakAuras.GetRegion(aura_env.id, aura_env.cloneId)\nif region and region.state and region.state.show then\n    aura_env.regions[aura_env.cloneId] = region\n    WeakAuras.ScanEvents(\"HDH_PROF\", region.state.event, 1)\nend",
["do_custom"] = true,
},
["init"] = {
["custom"] = "aura_env.regions = {}\n\naura_env.langDB = {\n    \n    ----------------------------------------------------------------\n    -- Professions\n    ----------------------------------------------------------------\n    [\"alchemyShort\"] = {\n        [\"enUS\"] = \"AL\",\n        [\"deDE\"] = \"AL\",\n        [\"frFR\"] = \"AL\",\n        [\"koKR\"] = \"연금\",\n        [\"ruRU\"] = \"АЛХ\",\n        [\"zhCN\"] = \"炼金\",\n        [\"zhTW\"] = \"煉金\"\n    },\n    \n    [\"blacksmithShort\"] = {\n        [\"enUS\"] = \"BS\",\n        [\"deDE\"] = \"BS\",\n        [\"frFR\"] = \"BS\",\n        [\"koKR\"] = \"대장\",\n        [\"ruRU\"] = \"КУЗ\",\n        [\"zhCN\"] = \"锻造\",\n        [\"zhTW\"] = \"鍛造\"\n    },\n    \n    [\"enchantShort\"] = {\n        [\"enUS\"] = \"EC\",\n        [\"deDE\"] = \"EC\",\n        [\"frFR\"] = \"EC\",\n        [\"koKR\"] = \"마부\",\n        [\"ruRU\"] = \"НЧ\",\n        [\"zhCN\"] = \"附魔\",\n        [\"zhTW\"] = \"附魔\"\n    },\n    \n    [\"engineerShort\"] = {\n        [\"enUS\"] = \"EG\",\n        [\"deDE\"] = \"EG\",\n        [\"frFR\"] = \"EG\",\n        [\"koKR\"] = \"기공\",\n        [\"ruRU\"] = \"ИНЖ\",\n        [\"zhCN\"] = \"工程\",\n        [\"zhTW\"] = \"工程\"\n    },\n    \n    [\"herbalism\"] = {\n        [\"enUS\"] = \"Herbalism\",\n        [\"koKR\"] = \"약초채집\",\n        [\"ruRU\"] = \"Травничество\",\n        [\"zhTW\"] = \"草藥學\"\n    },\n    \n    [\"herbalismShort\"] = {\n        [\"enUS\"] = \"HB\",\n        [\"deDE\"] = \"HB\",\n        [\"frFR\"] = \"HB\",\n        [\"koKR\"] = \"약초\",\n        [\"ruRU\"] = \"ТРВ\",\n        [\"zhCN\"] = \"草药\",\n        [\"zhTW\"] = \"草藥\",\n    },\n    \n    [\"inscriptionShort\"] = {\n        [\"enUS\"] = \"IS\",\n        [\"deDE\"] = \"IS\",\n        [\"frFR\"] = \"IS\",\n        [\"koKR\"] = \"주각\",\n        [\"ruRU\"] = \"НАЧ\",\n        [\"zhCN\"] = \"铭文\",\n        [\"zhTW\"] = \"銘文\"\n    },\n    \n    [\"jewelcraftShort\"] = {\n        [\"enUS\"] = \"JC\",\n        [\"de
},
["custom"] = "function(allstates, event, spellID, skillLineIndex, isGuildPerkSpell)\n    \n    if not spellID then return end\n    local spellInfo = C_Spell.GetSpellInfo(spellID)\n    \n    if not spellInfo or not C_Spell.IsSpellUsable(spellID) or not aura_env.spellIDList[spellID] \n    --print(spellID)\n    -- aura_env.saved.spellIDs[spellID] = true\n    --DevTools_Dump(aura_env.saved.spellIDs)\n    then return end\n    allstates[\"\"] = {\n        show = true,\n        changed = true,\n        progressType = \"timed\",\n        \n        duration = 10,\n        expirationTime = GetTime()+10 ,\n        autoHide = true,\n        name = spellInfo.name,\n        icon = spellInfo.iconID,\n        \n    }\n    return true\nend\n\n\n\n",

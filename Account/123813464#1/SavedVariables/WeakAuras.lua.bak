["init"] = {
["custom"] = "aura_env.allowlist = {\n    [183539] = true, --Barbed Tongue (Neltharion)\n    [200154] = true, --Burning Hatred (Neltharion)\n    [372225] = true, --Dragonbone Axe (Neltharion)\n    [378818] = true, --Magma Conflagration (Neltharion)\n    [374073] = true, --Seismic Slam (Halls of Infusion)\n    [374724] = true, --Molten Subduction (Halls of Infusion)\n    --[382593] = true, --Crushing Smash (Brackenhide Hollow)\n    [385832] = true, --Bloodthirsty Charge (Brackenhide Hollow)\n    [368287] = true, --Toxic Trap (Brackenhide Hollow)\n    [388060] = true, --Stink Breath (Brackenhide Hollow)\n    [367484] = true, --Vicious Clawmangle (Brackenhide Hollow)\n    [391136] = true, --Shoulder Slam (Azure Vault)\n    --[391723] = true, --Flame Breath (Ruby Life Pools)\n    --[391726] = true, --Storm Breath (Ruby Life Pools)\n    [387127] = true, --Chain Lightning (The Nokhud Offensive)\n    [382077] = true, --Command: Seek (The Nokhud Offensive)\n    [381683] = true, --Swift Stab (The Nokhud Offensive)\n    --[389054] = true, --Vicious Lunge (Algeth'ar Academy)\n}",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["auranames"] = {
"320168",
},
["unit"] = "player",
["debuffType"] = "HARMFUL",
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_type"] = "stateupdate",
["auraspellids"] = {
"328987",
},
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["events"] = "UNIT_TARGET:nameplate, UNIT_SPELLCAST_START:nameplate, UNIT_SPELLCAST_SUCCEEDED:nameplate, UNIT_SPELLCAST_STOP:nameplate, UNIT_SPELLCAST_FAILED:nameplate, UNIT_SPELLCAST_INTERRUPTED:nameplate, CAUSESE_DELAYED_SPELLCAST",
["custom"] = "function(allstates, event, unit, _, spellID)\n    if (event == \"UNIT_TARGET\" or event == \"CAUSESE_DELAYED_SPELLCAST\")\n    and UnitExists(unit)\n    and UnitIsUnit(unit..\"target\", \"player\")\n    then\n        local _,_,icon,_,expirationTime,_,_,nonInterruptible,spellId = UnitCastingInfo(unit)\n        local guid = UnitGUID(unit)\n        if spellId\n        and aura_env.allowlist[spellId]\n        and guid\n        and not allstates[guid] then\n            allstates[guid] = {\n                show = true,\n                changed =  true,\n                progressType = \"timed\", \n                duration = expirationTime / 1000 - GetTime(),\n                expirationTime = expirationTime / 1000,\n                name = \"Targeted\",\n                icon = icon,\n                autoHide = true,\n                spellID = spellId\n            }\n            return true\n        end\n        \n    elseif event == \"UNIT_SPELLCAST_START\" and aura_env.allowlist[spellID] then\n        C_Timer.After(0.15, function() WeakAuras.ScanEvents(\"CAUSESE_DELAYED_SPELLCAST\", unit) end)\n        \n    elseif (\n        event == \"UNIT_SPELLCAST_SUCCEEDED\"\n        or event == \"UNIT_SPELLCAST_STOP\"\n        or event == \"UNIT_SPELLCAST_FAILED\"\n        or event == \"UNIT_SPELLCAST_INTERRUPTED\"\n    )    \n    and UnitExists(unit)\n    then\n        local guid = UnitGUID(unit)\n        if guid then\n            local state = allstates[guid]\n            if state then\n                state.show = false\n                state.changed = true\n                return true\n            end\n        end\n    end\nend",
["spellIds"] = {
},

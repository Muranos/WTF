1,
},
["customText"] = "function()\n    local lines = {}\n    table.insert(lines, C_Spell.GetSpellInfo(aura_env.config.targetSpell).name)\n    for _, entry in ipairs(aura_env.debuffTable) do\n        if entry.applied then\n            local m = math.floor(entry.time / 60)\n            local s = math.floor(entry.time % 60)\n            table.insert(lines, string.format(\"%02d:%02d - %s\", m, s, entry.name))\n        end\n    end\n    return table.concat(lines, \"\\n\")\nend",
["shadowYOffset"] = -1,
["displayText_format_time_format"] = "none",
["customTextUpdate"] = "update",
["automaticWidth"] = "Auto",
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(states, event, timestamp, subEvent, _, _, _, _, _, destGUID, destName, destFlags, _, spellId)\n    \n    if event == \"ENCOUNTER_START\" then\n        aura_env.combatStart = GetTime()\n        states:RemoveAll()\n    end\n    \n    if subEvent == \"SPELL_AURA_APPLIED\" and spellId == aura_env.config.targetSpell then\n        local t = GetTime() - aura_env.combatStart\n        states:Update(timestamp..destGUID, {time = SecondsToClock(GetTime() - aura_env.combatStart, false), guid = destGUID, spell = C_Spell.GetSpellName(spellId)})\n        \n    end\n    \nend\n\n",

["width"] = 0.8,
["key"] = "spelltimer",
["default"] = "0",
["desc"] = "Duration when the triggered spells will happen, again seperated by a space if you have multiple",
["multiline"] = false,
["length"] = 10,
["name"] = "Duration of the triggered spells",
["useLength"] = false,
},
{
["type"] = "input",

["triggers"] = {
{
["trigger"] = {
["duration"] = "3",
["subeventPrefix"] = "SPELL",
["use_unit"] = true,
["match_count"] = "0",
["matchesShowOn"] = "showOnActive",
["use_absorbMode"] = true,
["debuffType"] = "HARMFUL",
["custom_type"] = "stateupdate",
["useName"] = false,

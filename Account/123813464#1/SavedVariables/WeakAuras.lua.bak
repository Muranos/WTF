["trigger"] = {
["auranames"] = {
"320168",
},
["unit"] = "player",
["debuffType"] = "HARMFUL",
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_type"] = "stateupdate",
["auraspellids"] = {
"328987",
},
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["events"] = "UNIT_TARGET:boss, UNIT_SPELLCAST_START:boss, UNIT_SPELLCAST_SUCCEEDED:boss, UNIT_SPELLCAST_STOP:boss, UNIT_SPELLCAST_FAILED:boss, UNIT_SPELLCAST_INTERRUPTED:boss, CAUSESE_DELAYED_SPELLCAST",
["custom"] = "function(allstates, event, unit, _, spellID)\n    if (event == \"UNIT_TARGET\" or event == \"CAUSESE_DELAYED_SPELLCAST\")\n    and UnitExists(unit)\n    and UnitIsUnit(unit..\"target\", \"player\")\n    then\n        local _,_,icon,_,expirationTime,_,_,nonInterruptible,spellId = UnitCastingInfo(unit)\n        local guid = UnitGUID(unit)\n        if spellId\n        and spellId == 386411\n        and guid\n        and not allstates[guid] then\n            allstates[guid] = {\n                show = true,\n                changed =  true,\n                progressType = \"timed\", \n                duration = expirationTime / 1000 - GetTime(),\n                expirationTime = expirationTime / 1000,\n                name = \"Targeted\",\n                icon = icon,\n                autoHide = true,\n                spellID = spellId\n            }\n            return true\n        end\n        \n    elseif event == \"UNIT_SPELLCAST_START\" and spellID == 386411 then\n        C_Timer.After(0.15, function() WeakAuras.ScanEvents(\"CAUSESE_DELAYED_SPELLCAST\", unit) end)\n        \n    elseif (\n        event == \"UNIT_SPELLCAST_SUCCEEDED\"\n        or event == \"UNIT_SPELLCAST_STOP\"\n        or event == \"UNIT_SPELLCAST_FAILED\"\n        or event == \"UNIT_SPELLCAST_INTERRUPTED\"\n    )    \n    and UnitExists(unit)\n    then\n        local guid = UnitGUID(unit)\n        if guid then\n            local state = allstates[guid]\n            if state then\n                state.show = false\n                state.changed = true\n                return true\n            end\n        end\n    end\nend",
["spellIds"] = {
},
["check"] = "event",
["useExactSpellId"] = false,
["useName"] = true,
["customVariables"] = "{spellID = \"number\"}",

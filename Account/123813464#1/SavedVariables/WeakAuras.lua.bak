["actions"] = {
["start"] = {
["custom"] = "local config = aura_env.config.events[aura_env.cloneId]\nlocal colour = config.colour\nlocal clone = aura_env.state\n\nif (clone and not clone.event_active and colour and config.tracked and aura_env.region) then\n    aura_env.region:Color(colour[1], colour[2], colour[3], colour[4])\nend\n\n\n\n\n\n",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "local aura_env = aura_env\nC_Timer.After(0, function() WeakAuras.ScanEvents(\"THE_WAR_WITHIN_EVENT_TRACKER\", aura_env.id) end)",
["do_custom"] = true,
},
["init"] = {
["custom"] = "-- Events can have the following properties:\n-- name: The name of the event\n-- activeName: (Optional) The name to be shown when event is active\n-- frequency: The frequency of the event in seconds\n-- duration: The duration of the event in seconds\n-- icon: The icon to display for the event\n-- quests: A list of quest IDs to track for the event\n-- start: A list of epoch times for the start of the event for each region\naura_env.events = {\n    \n    [\"storytime\"] = {\n        name = \"Story Time\", \n        activeName = \"Story Time active\",\n        frequency = 1800,\n        duration = 315,\n        icon = 132333,\n        achievement = {40992},\n        start = (GetServerTime()+GetQuestResetTime())+3660%10800,\n    },\n    [\"mountMania\"] = {\n        name = \"Mount Mania\", \n        activeName = \"Mount Mania active\",\n        frequency = 3600,\n        duration = 480,\n        icon = 132224,\n        achievement = {40985},\n        start = (GetServerTime()+GetQuestResetTime())+3660+2700%10800,\n    },\n    [\"fashionFrenzy\"] = {\n        name = \"Fashion Frenzy\", \n        activeName = \"Fashion Frenzy active\",\n        frequency = 3600,\n        duration = 300,\n        icon = 4524582,\n        achievement = {40987},\n        start = (GetServerTime()+GetQuestResetTime())+3660+900%10800,\n    },\n}",
["do_custom"] = true,
},

["custom"] = "if aura_env.state and aura_env.state.unit and UnitExists(aura_env.state.unit) then\n    local class = UnitClassBase(aura_env.state.unit)\n    \n    if class then\n        local class_color = C_ClassColor.GetClassColor(class)\n        aura_env.region.bar:SetForegroundColor(class_color:GetRGB())\n    end\nend\n\n\n",

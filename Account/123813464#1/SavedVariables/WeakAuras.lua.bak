["custom"] = "function(allstates, event, unit, _, spellID)\n    if spellID == 377559\n    and UnitIsUnit(unit..\"target\", \"player\")\n    then\n        local _, _, _, startC, endC  = UnitCastingInfo(unit)\n        local duration = (endC - startC) / 1000\n        local expirationTime = endC / 1000\n        if endC then\n            allstates[spellID] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = duration,\n                expirationTime = expirationTime,\n                autoHide = true,\n            } \n            return true\n        end\n    end\nend",

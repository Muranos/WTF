["sparkHidden"] = "NEVER",
["width"] = 190,
["inverse"] = false,
["uid"] = "xGrwZxQBxV6",
["orientation"] = "HORIZONTAL",
["conditions"] = {
{
["check"] = {
["trigger"] = -1,
["variable"] = "customcheck",
["value"] = "function()\n    local auraID, cloneID  = aura_env.id, aura_env.cloneId\n    local region = WeakAuras.GetRegion(auraID, cloneID)\n    \n    if aura_env.config.vault.icons or region.state.event == \"pvp\" then\n        region.subRegions[5]:Show()\n        region.subRegions[6]:Hide()\n    else\n        region.subRegions[6]:Show()\n        region.subRegions[5]:Hide()\n    end\nend",
},

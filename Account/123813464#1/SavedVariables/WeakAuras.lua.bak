["actions"] = {
["start"] = {
["custom"] = "\nif aura_env.config[\"MainRingClassColor\"] then\n    local c = RAID_CLASS_COLORS[select(2,UnitClass(\"player\"))]\n    aura_env.region:Color(c.r, c.g, c.b,1)\nend\n\n\n\n\n\n\n",
["do_custom"] = true,
},
["init"] = {
["custom"] = "if aura_env.config[\"TrackHealth\"]  then\n    aura_env.region:Color(255,255,255,0)\nelse\n    \n    if aura_env.config[\"ShowOnKeyPress\"] then\n        aura_env.region:Color(255,255,255,0)\n    end    \nend",

["height"] = 10,
["textureSource"] = "LSM",
["sparkBlendMode"] = "ADD",
["useAdjustededMax"] = false,
["source"] = "import",
["icon"] = false,
["icon_side"] = "RIGHT",
["xOffset"] = 0,
["preferToUpdate"] = false,

["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "aura_env.db = {}\n\n-- transliteration\naura_env.langDB = {\n    \n    -- Chinese (Simplified)\n    [\"zhCN\"] = \"活动\",\n    \n    -- Chinese (Taiwan)\n    [\"zhTW\"] =\"活動\",\n    \n    -- English (US)\n    [\"enUS\"] =\"Activities\",\n    \n    -- French (FR)\n    [\"frFR\"] =\"Activités\",\n    \n    -- German\n    [\"deDE\"] = \"Aktivitäten\",\n    \n    -- Korean (KR)\n    [\"koKR\"] = \"활동\",\n    \n    -- Russian (RU)\n    [\"ruRU\"] = \"Деятельности\",\n}",
["do_custom"] = true,
},
["finish"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["unit"] = "player",
["event"] = "Health",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["customName"] = "function()\n    return aura_env.langDB[GetLocale()] or aura_env.langDB[\"enUS\"]\nend",
["spellIds"] = {
},
["events"] = "START, QUEST_COMPLETE, HDH_ACTIVITY",
["check"] = "event",
["custom_type"] = "status",
["custom"] = "function(event, ...)\n    -- parse input\n    if event == \"HDH_ACTIVITY\" then\n        local clone, value = ...\n        aura_env.db = { [clone] = value }\n    end\n    \n    -- check if anything is showing\n    local count = 0\n    for _, i in pairs(aura_env.db) do\n        count = i == 1 and count + 1\n    end    \n    \n    if count == 0 then return end\n    \n    if aura_env.config.activities.activityEnable then return true end\nend",
["debuffType"] = "HELPFUL",
},
